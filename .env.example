# 复制为 .env 后填写。所有服务都用 OpenAI 兼容协议，换供应商只需改这三行。

# ---- 大模型（生成）----
# 例：DeepSeek https://api.deepseek.com/v1       模型 deepseek-chat
#     智谱     https://open.bigmodel.cn/api/paas/v4/  模型 glm-4-flash
#     本地     http://localhost:11434/v1         模型 qwen2.5:7b
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=sk-xxxxxx
LLM_MODEL=glm-5

# ---- Embedding（向量化）----
# 必须与建库时保持一致，否则索引失效需重建（index_meta.json 指纹校验）
EMBED_PROVIDER=local              # local = 本地 LawVault（离线/免费/法律微调）；api = OpenAI 兼容接口

# provider=local 时生效
EMBED_MODEL_PATH=models/lawvault  # 相对项目根目录，config.py 负责解析成绝对路径
EMBED_BATCH_SIZE=32               # CPU 建库批大小，内存紧张就调小

# provider=api 时生效
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBED_MODEL=BAAI/bge-m3

# VPN 断开时重新下载模型用，平时注释
# HF_ENDPOINT=https://hf-mirror.com

# ---- 检索参数 ----
TOP_K=6
CHUNK_SIZE=600
CHUNK_OVERLAP=120
